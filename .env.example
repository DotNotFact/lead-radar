# Telegram control bot (aiogram) — токен от @BotFather
BOT_TOKEN=

# Контакт для честного User-Agent при обращении к внешним источникам (email или ссылка на профиль)
CONTACT_EMAIL=

# Telegram userbot для чтения чатов (Telethon) — my.telegram.org, ОТДЕЛЬНАЯ симка, не основной аккаунт
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=lead_radar_collector

# Приватный канал владельца для уведомлений (numeric id, обычно начинается с -100)
CHANNEL_ID=

# Локальный прокси для доступа к api.telegram.org, если Telegram заблокирован напрямую -
# частая ситуация. Формат: http://127.0.0.1:PORT или socks5://127.0.0.1:PORT. Оставить пустым,
# если Telegram доступен без прокси. httpx (hh.ru/Kwork/RSS) прокси не требует - сам читает
# HTTP_PROXY/HTTPS_PROXY из переменных окружения, если они заданы.
TELEGRAM_PROXY_URL=

# Отслеживание собственных откликов на hh.ru (OAuth от личного аккаунта, НЕ публичный API
# вакансий). Зарегистрировать приложение: https://dev.hh.ru/admin, тип "Веб". Redirect URI -
# любой валидный https-адрес, код авторизации копируется вручную (см. scripts/hh_oauth_login.py).
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
# Заполняются автоматически скриптом hh_oauth_login.py / при рефреше - руками не трогать
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=

# Freelancer.com: личный OAuth-токен, не публичный ключ приложения. Получить: зайти на
# https://accounts.freelancer.com/settings/develop -> Sandbox/Live token, скопировать сюда.
# Без токена источник "freelancer" в config/sources.yaml остаётся enabled: false.
FREELANCER_OAUTH_TOKEN=

# Хранилище
DB_PATH=data/lead_radar.db

# Логи
LOG_DIR=logs
LOG_LEVEL=INFO

# Скоринг
SCORE_THRESHOLD=50
MIN_BUDGET_RUB=5000

# Ежедневный бриф (HH:MM, локальное время машины)
DAILY_BRIEF_TIME=09:00
